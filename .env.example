# ===== Supabase =====
# Salin file ini menjadi .env.local lalu isi nilainya
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Kredensial berikut TIDAK dipakai aplikasi langsung (referensi saja):
# SUPABASE_SECRET_KEY=sb_secret_xxx          # server-only, jangan pernah expose
# SUPABASE_JWKS_URL=https://xxx/auth/v1/.well-known/jwks.json

# ===== WhatsApp Business Cloud API (Meta) =====
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_STATUS=gank_status_update
WHATSAPP_TEMPLATE_DONE=gank_service_done

# ===== Branding / Kontak =====
NEXT_PUBLIC_WA_NUMBER=6281234567890
NEXT_PUBLIC_ADDRESS=Jl. Teknologi No. 88

# URL publik untuk link tracking di pesan WhatsApp
NEXT_PUBLIC_APP_URL=http://localhost:3000

# (Opsional) Domain origin tambahan untuk Server Actions saat diakses lewat
# port-forwarding/reverse proxy. Pisahkan dengan koma; dukung wildcard
# subdomain, contoh: *.app.example.dev, tunnel.gank.id
SERVER_ACTIONS_ALLOWED_ORIGINS=
